# Copy to deploy/.env and change every value marked CHANGE before production.

ENV=development

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=brandintel
POSTGRES_PASSWORD=brandintel            # CHANGE
POSTGRES_DB=brandintel
POSTGRES_PORT=5432
# Used by the backend when run outside Docker (local development / tests):
DATABASE_URL=postgresql+psycopg://brandintel:brandintel@localhost:5432/brandintel

# --- Redis --------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO, S3-compatible) -------------------------------------
S3_ACCESS_KEY=brandintel
S3_SECRET_KEY=brandintel-secret         # CHANGE
S3_BUCKET=evidence
S3_ENDPOINT_URL=http://localhost:9000
# Address browsers use to open evidence links:
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change-me-in-production      # CHANGE (long random string)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026  # CHANGE

# --- Web ----------------------------------------------------------------------
API_PORT=8010
WEB_PORT=3000
PUBLIC_API_URL=http://localhost:8010
CORS_ORIGINS=["http://localhost:3000"]

# --- Test website (automated tests only) ---------------------------------------
FIXTURES_PORT=8088
FIXTURES_BASE_URL=http://localhost:8088
# Must stay empty: lets the fetcher reach private addresses (tests use their own setting).
FETCH_ALLOW_PRIVATE_HOSTS=[]

# --- Email analysis (phishing-email module) ------------------------------------
RSPAMD_PORT=11333
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
# Threat intelligence for email links and look-alike domains (optional; without a key that source shows "not checked")
URLHAUS_AUTH_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=

# Email intake (optional). Reporting mailbox for forwarded phishing, and DMARC aggregate-report mailbox.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
DMARC_IMAP_HOST=
DMARC_IMAP_PORT=993
DMARC_IMAP_USER=
DMARC_IMAP_PASSWORD=
DMARC_IMAP_MAILBOX=INBOX
# Microsoft 365 (optional): app registration with Mail.Read + admin consent
MS_GRAPH_TENANT=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER=
# Google Workspace (optional): service account with domain-wide delegation, gmail.readonly
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_DELEGATED_USER=

# --- External sources -------------------------------------------------------------
# Recommended: a search API key (Brave free tier) for reliable APK / document / social discovery.
# Without one, a paced free fallback is used (DuckDuckGo public page) and pauses when rate-limited (D-23).
FREE_SEARCH_FALLBACK=true
FREE_SEARCH_INTERVAL_SECONDS=12
# Without Telegram API credentials, public t.me pages are checked instead (D-23).
TELEGRAM_PUBLIC_FALLBACK=true
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- Social media brand-misuse monitor (optional; empty = that source shows "not configured") -------------------
# YouTube Data API v3 key: console.cloud.google.com > APIs & Services > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# Facebook Pages search: App ID + App Secret (developers.facebook.com > your app > Settings > Basic); needs "Page Public Content Access".
META_APP_ID=
META_APP_SECRET=
META_GRAPH_TOKEN=
# Meta Ad Library API token (facebook.com/ads/library/api, needs identity verification).
# Note: returns commercial ads only when shown in the EU/UK; political/issue ads in every country.
META_AD_LIBRARY_TOKEN=
META_AD_COUNTRIES=["IN"]
# Threads API token with the threads_keyword_search permission (Meta app review)
THREADS_ACCESS_TOKEN=
# X (Twitter) API v2 bearer token (developer.x.com, paid pay-per-use)
X_BEARER_TOKEN=
# Social media content window: posts, videos and ads published in the last N days (730 = 2 years)
SOCIAL_MEDIA_LOOKBACK_DAYS=730
SOCIAL_MEDIA_SCAM_LOOKBACK_DAYS=730
SOCIAL_MEDIA_MAX_ITEMS=60
# Apify (paid scrapers, D-43): Instagram, TikTok, Facebook posts, Meta Ad Library, X and LinkedIn — content for the
# social media monitor and real profiles for impersonation. Token: console.apify.com > Settings > API & Integrations.
# Runs next to the official APIs and web search (YouTube keeps its own API). Billed per result: keep the caps low.
APIFY_TOKEN=
APIFY_PLATFORMS=["instagram","tiktok","facebook","meta_ads","x","linkedin"]
APIFY_ITEMS_PER_QUERY=20
APIFY_SCAM_QUERIES=3
APIFY_MAX_CHARGE_USD=0.5
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_CACHE_MINUTES=180

# --- Common Crawl (extra Fake APK source, no key; slow public index, paced and time-boxed) -------------------------
COMMON_CRAWL_ENABLED=true
COMMON_CRAWL_COLLECTIONS=2
COMMON_CRAWL_BUDGET_SECONDS=240
# Domain scans: parallel website captures and a time budget (domains not reached go first next scan, D-48)
DOMAIN_CHECK_WORKERS=3
DOMAIN_SCAN_BUDGET_SECONDS=2700
